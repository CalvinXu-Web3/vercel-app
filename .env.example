# Public application address. Use the Vercel production URL after the first deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL. The Neon + Vercel integration can inject DATABASE_URL automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clerk authentication. Never expose CLERK_SECRET_KEY in browser code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Comma-separated Clerk user IDs. Signed-in users not listed here are contributors only.
CRN_ADMIN_USER_IDS=user_REPLACE_ME
CRN_REVIEWER_USER_IDS=user_REPLACE_ME

# Pinata server secret. Keep this in Vercel's encrypted environment variables only.
PINATA_JWT=REPLACE_ME
# private IPFS is available only on an eligible Pinata plan. The default alternative
# stores client-side encrypted ciphertext on public IPFS.
PINATA_NETWORK=public
EVIDENCE_STORAGE_MODE=encrypted-public-ipfs
NEXT_PUBLIC_EVIDENCE_STORAGE_MODE=encrypted-public-ipfs
# One-line RSA-OAEP/SHA-256 public JWK. It is safe to expose the public key.
# The matching private key must stay outside Vercel and outside this repository.
NEXT_PUBLIC_EVIDENCE_PUBLIC_KEY_JWK={"kty":"RSA","n":"REPLACE_ME","e":"AQAB","alg":"RSA-OAEP-256","ext":true}

# Required only when EVIDENCE_STORAGE_MODE=private-ipfs.
PINATA_PRIVATE_GATEWAY_URL=https://YOUR_GATEWAY.mypinata.cloud
PINATA_GROUP_ID=

# Upload policy. Files are restricted evidence by default and must pass review before
# any redacted metadata can be published.
EVIDENCE_MAX_BYTES=26214400
EVIDENCE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,application/zip
